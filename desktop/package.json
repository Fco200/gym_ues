{
  "name": "gym-ues-checador",
  "version": "1.0.0",
  "private": true,
  "description": "Kiosco de escritorio - Checador de alumnos del Gimnasio UES (Universidad Estatal de Sonora)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --url=http://localhost:5173/checador",
    "autostart": "electron . --autostart",
    "no-autostart": "electron . --no-autostart",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ues.gym.checador",
    "productName": "Gym UES Checador",
    "files": [
      "main.js",
      "waiting.html",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true
    }
  }
}